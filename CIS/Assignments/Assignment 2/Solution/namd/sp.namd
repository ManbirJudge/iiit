# NAMD, protein in water box, 9 A cutoff, switched (no PME), flexible bonds, 1 fs  -- Amber ff14SB + TIP3P
amber            yes
parmfile         ../input/2HEP.prmtop
ambercoor        ../input/2HEP_equil.rst7
readexclusions   yes
exclude          scaled1-4
1-4scaling       0.833333
scnb             2.0

# non-bonded: 9 A cutoff with a smooth switching function from 8 to 9 A, NO PME, no long-range correction
switching        on
switchdist       8.0
cutoff           9.0
pairlistdist     11.0
LJcorrection     off
PME              no

# integrator: all bonds flexible
timestep         1.0
rigidBonds       none
nonbondedFreq    1
fullElectFrequency 1
stepspercycle    10
wrapAll          on

# periodic box (from the rst7) and its centre
cellBasisVector1 50.0497 0.0 0.0
cellBasisVector2 0.0 45.8629 0.0
cellBasisVector3 0.0 0.0 57.3461
cellOrigin       25.0248 22.9315 28.6730

# single point energy of the starting structure
temperature      0
outputName       out/sp
outputEnergies   1
run              0
